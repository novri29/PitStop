<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvJudulPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="Preview Struk"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EEEEEE">

        <!-- Lebar preview (PREVIEW_WIDTH_DOTS di BluetoothPrinterHelper.kt) sengaja DIBUAT
             TETAP di semua device (tidak lagi ikut lebar layar) supaya struk yang sama selalu
             terlihat sama besar baik dibuka di tablet maupun HP. HorizontalScrollView di sini
             cuma jaga-jaga: kalau lebar tetap itu kebetulan lebih lebar dari layar device yang
             sangat kecil, preview tetap bisa digeser lihat semua sisinya (bukan terpotong). -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- WebView-nya ditempel LANGSUNG di sini (area yang benar-benar tampil di
                         layar), bukan di container tersembunyi 0x0 seperti sebelumnya.
                         WebView modern (berbasis Chromium) SENGAJA tidak merender konten kalau
                         dianggap "tidak terlihat di layar", itu penyebab preview kemarin
                         hasilnya putih kosong. Dengan ditaruh di sini, preview jadi WebView yang
                         hidup sungguhan, bukan sekadar bitmap statis. -->
                    <FrameLayout
                        android:id="@+id/containerWebViewPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/white"
                        android:elevation="3dp" />

                </LinearLayout>
            </ScrollView>
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/progressPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvStatusPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="48dp"
            android:text="Menyiapkan preview..."
            android:textColor="@color/grey"
            android:textSize="12sp" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBatalPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Batal"
            android:textColor="@color/white"
            app:backgroundTint="@color/red" />

        <Button
            android:id="@+id/btnCetakPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:enabled="false"
            android:text="Cetak Sekarang" />

    </LinearLayout>

</LinearLayout>